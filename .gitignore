# Rust
/target
**/*.rs.bk

# Node / Bun
node_modules/
dist/
.vite/
*.tsbuildinfo

# Bun
bun.lockb

# Editor / OS
.DS_Store
.idea/
.vscode/
*.log

# Claude Code local project instructions — .worktreeinclude only copies
# files that are git-ignored, so this rule is what makes that entry work.
CLAUDE.local.md

# please plugin runtime state
.please/state/

# Per-agent memory indexes, generated from the notes beside them by
# `bun scripts/agent-memory-index.ts`. The notes themselves stay tracked — only
# this table of contents is derived, because tracking it made every concurrent
# PR that recorded a memory for the same agent collide on one appended line and
# risk dropping a third party's entry on resolve (issue #129).
.claude/agent-memory/*/MEMORY.md
