{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://honmoon.dev/schema/policy.schema.json",
  "title": "Honmoon Policy",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "egress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": { "$ref": "#/$defs/verdict" },
        "allow": { "type": "array", "items": { "type": "string" } },
        "deny": { "type": "array", "items": { "type": "string" } }
      }
    },
    "endpoints": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/endpoint" }
    },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "verdict": {
      "type": "string",
      "enum": ["allow", "deny", "pause"]
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port"],
      "properties": {
        "host": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "protocol": {
          "type": "string",
          "enum": ["postgres", "kubernetes", "tcp"],
          "default": "tcp"
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "endpoint", "condition", "verdict"],
      "properties": {
        "name": { "type": "string" },
        "endpoint": { "type": "string" },
        "condition": {
          "type": "string",
          "minLength": 1,
          "pattern": "[^\\s\\u0085]|\\uFEFF",
          "description": "CEL expression over protocol facts. Must not be blank: a blank condition carries no expression, so the rule can never match and would sit in the policy looking active while doing nothing -- Policy::from_yaml refuses to load one. Write \"true\" for a rule that always matches. The pattern mirrors the Rust check (char::is_whitespace) exactly: ECMAScript \\s differs from Unicode White_Space only by excluding U+0085 and including U+FEFF, and the class corrects for both. It is not a CEL validator -- a non-blank condition that is not a valid expression passes here and is refused by Policy::from_yaml instead, which since #191 fails the load and names every rule whose condition did not compile."
        },
        "verdict": { "$ref": "#/$defs/verdict" }
      }
    }
  }
}
