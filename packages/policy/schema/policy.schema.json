{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://honmoon.dev/schema/policy.schema.json",
  "title": "Honmoon Policy",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "egress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": { "$ref": "#/$defs/verdict" },
        "allow": { "type": "array", "items": { "type": "string" } },
        "deny": { "type": "array", "items": { "type": "string" } }
      }
    },
    "endpoints": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/endpoint" }
    },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "verdict": {
      "type": "string",
      "enum": ["allow", "deny", "pause"]
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port"],
      "properties": {
        "host": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "protocol": {
          "type": "string",
          "enum": ["postgres", "kubernetes", "tcp"],
          "default": "tcp"
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "endpoint", "condition", "verdict"],
      "properties": {
        "name": { "type": "string" },
        "endpoint": { "type": "string" },
        "condition": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "CEL expression over protocol facts. Must not be blank: `Program::compile` panics on a condition that lexes to no tokens, so `Policy::from_yaml` refuses to load one. Write \"true\" for a rule that always matches."
        },
        "verdict": { "$ref": "#/$defs/verdict" }
      }
    }
  }
}
