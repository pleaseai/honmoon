{
  "compilerOptions": {
    "target": "es2023",
    "jsx": "react",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment",
    "lib": [
      "es2023"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [],
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": [
    ".claude/types",
    "hooks"
  ],
  "exclude": [
    "hooks/*.test.ts"
  ]
}
